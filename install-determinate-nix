#!/usr/bin/env zsh
# ./install-determinate-nix [HOSTNAME] -- install Determinate Nix from the
# official universal pkg, then adopt this Mac's hostname for the flake.
#
# HOSTNAME defaults to the current `scutil --get LocalHostName`; it is also
# set as HostName and ComputerName so darwin-rebuild finds the flake host.
# It also removes the comment-only /etc/nix/nix.custom.conf the installer
# writes (nix-darwin refuses to activate over it) and runs ./adopt to add the
# host to the flake, then runs ./s to switch (which installs the macFUSE cask
# bindfs-mac needs, retrying activation once on a fresh Mac).
set -eu

url="https://install.determinate.systems/determinate-pkg/stable/Universal"
host="${1:-$(scutil --get LocalHostName)}"

if [[ ! -x /nix/var/nix/profiles/default/bin/nix ]]; then
  pkg="$(mktemp -d)/determinate-nix.pkg"
  curl --fail --location --silent --show-error --output "$pkg" "$url"
  sudo installer -pkg "$pkg" -target /
  rm -f "$pkg"
else
  echo "Nix is already installed; skipping the pkg"
fi

for key in HostName LocalHostName ComputerName; do
  sudo scutil --set "$key" "$host"
done

conf=/etc/nix/nix.custom.conf
if [[ -f $conf && ! -L $conf ]] && ! grep -qvE '^[[:space:]]*(#.*)?$' "$conf"; then
  echo "removing comment-only $conf so activation can manage it"
  sudo rm -f "$conf"
fi

"${0:A:h}/adopt" --host "$host"
echo "installed, hostname $host adopted, stub config cleared; running ./s"
cd "${0:A:h}"
exec ./s
