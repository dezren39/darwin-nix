{
  // OpenCode v2 config (developing-today-forks/opencode), v2-native keys only:
  // v1's `agent`, `permission`, `plugin`, `autoupdate` and `compaction.reserved`
  // are `agents`, `permissions`, `plugins`, `update` and `compaction.buffer` here,
  // and v2 reads terminal settings from ~/.config/opencode/cli.json, not tui.jsonc.
  //
  // This file mirrors the live config, ~/.opencode/opencode.jsonc (reached as
  // ~/.config/opencode/opencode.jsonc), which OpenChamber edits and which is
  // not linked to this file (ARCHITECTURE.md section 5); `just
  // opencode-config-link` would make this file the live one. The routing
  // below (the default model and agent, every route and pool, the hidden
  // routes, subagent_depth and tuning) is copied from the live file, comments
  // and all; it was last copied on 2026-11-24. Check that it still matches:
  //   node .agents/skills/delegate/scripts/pools.mjs --diff opencode-global.jsonc
  //
  // The live file's own header, kept verbatim:
  // Copilot-machine pools — built 2026-11-16 from AA Intelligence Index v5.1
  // (score + time/task only; cost ignored). Each pool leg below is annotated
  // "AA <score> @ <minutes> min" from that index.
  // Gemini 4 Hydrogen: every route, hidden entry and pool leg for it is kept
  // below but commented out; uncomment those lines to re-enable it.
  // Models blocked for this use case, or leaving Copilot, are deliberately
  // absent.
  //
  // HOW THE FORCING WORKS (verified in the fork, model-governance.ts /
  // model-resolver.ts): a target's own #variant pin beats the variant the pool
  // was called with, at every called effort including no-effort calls. A pool
  // whose targets are all pinned offers no levels of its own, so callers cannot
  // pick an effort for it — every call runs exactly the list below. No remap
  // tables are needed, and remapping to "" would not do this (that value does
  // not exist; a remap value is a variant id, or false to sit a level out).
  //
  // A pinned variant the model does not offer silently drops that leg from the
  // pool (config/plugin/model-routes.ts), so check the model's variants before
  // changing a pin. Model ids are the github-copilot catalog ids — verify on
  // this machine with: opencode models | grep github-copilot

  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "warming": true,
  "compaction": { "buffer": 8192 },
  "websearch": { "provider": "random" },

  "model": "github-copilot/claude-opus-5.5",
  "default_agent": "build",
  // No agent pins a model, so a subagent runs its parent's model unless its
  // launch names one (instructions/work-strategies.md, the delegate skill).
  // The capability subagents this file used to define (deep, balanced,
  // quick) pointed at pools the live config no longer has.
  "agents": {
    "plan": { "disabled": true }
  },

  // hidden = absent from the picker, but still routable and directly
  // resolvable (fork #230; the model-routes plugin applies these overrides
  // to route models). Do NOT use "disabled" here — that would remove the
  // routes from the pools too. The seven pools stay visible/selectable.
  // Needs opencode with developing-today/opencode 118d889 (#1547); older
  // builds (f9aa962) skipped building every route when this block existed.
  // The key is v2's "providers", not v1's "provider": the v1 migration
  // (core/src/v1/config/migrate.ts) drops "hidden" and "disabled", so under
  // "provider" every entry loaded as {} and nothing was hidden.
  "providers": {
    "opencode-route": {
      "models": {
        "luna":     { "hidden": true },
        "terra":    { "hidden": true },
        "sol":      { "hidden": true },
        "haiku":    { "hidden": true },
        "sonnet":   { "hidden": true },
        "opus":     { "hidden": true },
        // "hydrogen": { "hidden": true },
        "carbon":   { "hidden": true },
        "mai":      { "hidden": true }
      }
    }
  },

  // v2 reads the depth limit only from experimental.subagent_depth; a
  // top-level subagent_depth is dropped with a diagnostic and the limit
  // silently falls back to 1 (core/src/tool/plugin/subagent.ts).
  "experimental": {
    "subagent_depth": 10,
    "model_routes": {
      // ---- per-model routes: one Copilot leaf each, no -plan suffix ----
      "luna": {
        "name": "GPT-6 Luna (Copilot)",
        "targets": ["github-copilot/gpt-6-luna"],
        "selection": "ordered",
        "autonomy": "rules",
        "health": {
          "firstTokenTimeoutMs": 60000
        }
      },
      "terra": {
        "name": "GPT-6.1 Terra (Copilot)",
        "targets": ["github-copilot/gpt-6.1-terra"],
        "selection": "ordered",
        "autonomy": "rules",
        "health": {
          "firstTokenTimeoutMs": 60000
        }
      },
      "sol": {
        "name": "GPT-6.1 Sol (Copilot)",
        "targets": ["github-copilot/gpt-6.1-sol"],
        "selection": "ordered",
        "autonomy": "rules",
        "health": {
          "firstTokenTimeoutMs": 60000
        }
      },
      "haiku": {
        "name": "Claude Haiku 5.5 (Copilot)",
        "targets": ["github-copilot/claude-haiku-5.5"],
        "selection": "ordered",
        "autonomy": "rules",
        "health": {
          "firstTokenTimeoutMs": 60000
        }
      },
      "sonnet": {
        "name": "Claude Sonnet 5.5 (Copilot)",
        "targets": ["github-copilot/claude-sonnet-5.5"],
        "selection": "ordered",
        "autonomy": "rules",
        "health": {
          "firstTokenTimeoutMs": 60000
        }
      },
      "opus": {
        "name": "Claude Opus 5.5 (Copilot)",
        "targets": ["github-copilot/claude-opus-5.5"],
        "selection": "ordered",
        "autonomy": "rules",
        "health": {
          "firstTokenTimeoutMs": false
        }
      },
      // "hydrogen": {
      //   "name": "Gemini 4 Hydrogen (Copilot)",
      //   "targets": ["github-copilot/gemini-4-hydrogen"],
      //   "selection": "ordered",
      //   "autonomy": "rules"
      // },
      "carbon": {
        "name": "Gemini 4 Carbon (Copilot)",
        "targets": ["github-copilot/gemini-4-carbon"],
        "selection": "ordered",
        "autonomy": "rules",
        "health": {
          "firstTokenTimeoutMs": false
        }
      },
      "mai": {
        "name": "MAI-Code-1.1-Flash (Copilot, unmeasured on AA)",
        "targets": ["github-copilot/mai-code-1.1-flash"],
        "selection": "ordered",
        "autonomy": "rules",
        "health": {
          "firstTokenTimeoutMs": 60000
        }
      },

      // ---- the seven pools: ordered, every leg pinned ----
      // Legs are tried top to bottom; the next leg is used only on failover.
      // A trailing comma before a commented Hydrogen leg is deliberate (JSONC
      // allows it) so that leg can be uncommented as-is.
      // "autonomy": "agent" keeps the ordered selection (it includes "rules")
      // and keeps route_stats / route_adjust available to the agent; those
      // tools disappear when no route is at "agent" (model-route-autonomy.ts).
      "small": {
        "targets": [
          "opencode-route/sol#low",          // AA 34.8 @ 1.9 min
          // "opencode-route/hydrogen#low",  // AA 26.9 @ 1.4 min
          "opencode-route/haiku#medium"      // AA 24.6 @ 4.0 min
        ],
        "selection": "ordered",
        "autonomy": "agent",
        "health": {
          "firstTokenTimeoutMs": 60000
        }
      },
      "speed": {
        "targets": [
          "opencode-route/terra#medium",        // AA 38.2 @ 2.8 min
          // "opencode-route/hydrogen#medium",  // AA 41.2 @ 3.8 min
          "opencode-route/opus#low"             // AA 34.8 @ 3.0 min
        ],
        "selection": "ordered",
        "autonomy": "agent",
        "health": {
          "firstTokenTimeoutMs": 60000
        }
      },
      "scout": {
        "targets": [
          "opencode-route/sol#medium",          // AA 46.4 @ 4.3 min
          // "opencode-route/hydrogen#medium",  // AA 41.2 @ 3.8 min
          "opencode-route/opus#low"             // AA 34.8 @ 3.0 min
        ],
        "selection": "ordered",
        "autonomy": "agent",
        "health": {
          "firstTokenTimeoutMs": 60000
        }
      },
      "workhorse": {
        "targets": [
          "opencode-route/opus#medium",       // AA 48.2 @ 6.9 min
          "opencode-route/sol#high",          // AA 50.3 @ 7.6 min
          // "opencode-route/hydrogen#high",  // AA 50.8 @ 8.4 min
        ],
        "selection": "ordered",
        "autonomy": "agent",
        "health": {
          "firstTokenTimeoutMs": 62000
        }
      },
      "specialist": {
        "targets": [
          "opencode-route/sol#xhigh",         // AA 52.5 @ 9.9 min
          "opencode-route/opus#xhigh",        // AA 57.4 @ 15.7 min
          // "opencode-route/hydrogen#xhigh", // AA 53.9 @ 14.8 min
        ],
        "selection": "ordered",
        "autonomy": "agent",
        "health": {
          "firstTokenTimeoutMs": 60000
        }
      },
      "summit": {
        "targets": [
          "opencode-route/carbon#high",       // AA 60.0 @ 32.1 min
          "opencode-route/opus#max",          // AA 59.1 @ 24.9 min
          "opencode-route/sol#max"            // AA 54.6 @ 22.9 min
        ],
        "selection": "ordered",
        "autonomy": "agent",
        "health": {
          "firstTokenTimeoutMs": false
        }
      },
      "background": {
        "targets": [
          "opencode-route/carbon#medium",     // AA 58.3 @ 28.4 min
          "opencode-route/sol#max",           // AA 54.6 @ 22.9 min
          "opencode-route/sonnet#max"         // AA 54.5 @ 31.4 min
        ],
        "selection": "ordered",
        "autonomy": "agent",
        "health": {
          "firstTokenTimeoutMs": 60000
        }
      }
    },
    "model_route_tuning": {
      "enabled": true
    }
  },

  // v1 plugins that v2's loader rejects ("must export a default definition
  // with an id and an effect or setup function"); each failed on every load.
  // Re-enable once ported to v2's { id, setup } shape:
  //   "opencode-pty@latest",
  //   "@franlol/opencode-md-table-formatter@latest",
  //   "opencode-auto-continue@https://github.com/developing-today/opencode-auto-continue/archive/refs/tags/latest.tar.gz"
  "plugins": ["@mohak34/opencode-notifier@latest"],

  // Extra skill directories (`~/` is expanded). ~/git/cairn
  // (github.com/dezren39/cairn) holds prompts, goals and agent practices as
  // Agent Skills: agent-practices, prompt-writer, stage-goals,
  // research-capture, skill-writer. Its skills refer to its own files by
  // paths under ~/git/cairn, so keep the clone there.
  "skills": ["~/git/cairn/.agents/skills"],

  "instructions": [
    "~/.config/opencode/instructions/worktrees.md",
    "~/.config/opencode/instructions/recordings.md",
    "~/.config/opencode/instructions/work-strategies.md"
  ],

  // Ordered rules; for the same action, later rules override earlier ones.
  // Migrated from v1 by v2's own normalizer (bash -> shell). Dropped as inert
  // in v2: lsp, plan_enter, plan_exit, and the rule for the removed `custom`
  // subagent.
  "permissions": [
    // Override the built-in agent denies too (explore, general, title,
    // summary). Specific ask rules below remain in force; order matters.
    {"action":"*","resource":"*","effect":"allow"},
    {"action":"read","resource":"*","effect":"allow"},
    {"action":"todowrite","resource":"*","effect":"allow"},
    {"action":"edit","resource":"*","effect":"allow"},
    {"action":"external_directory","resource":"*","effect":"allow"},
    {"action":"shell","resource":"*","effect":"allow"},
    {"action":"shell","resource":"bash -c *","effect":"ask"},
    {"action":"shell","resource":"sh -c *","effect":"ask"},
    {"action":"shell","resource":"zsh -c *","effect":"ask"},
    {"action":"shell","resource":"eval *","effect":"ask"},
    {"action":"shell","resource":"git remote add *","effect":"ask"},
    {"action":"shell","resource":"git stash *","effect":"ask"},
    {"action":"shell","resource":"git branch -d*","effect":"ask"},
    {"action":"shell","resource":"git branch -D*","effect":"ask"},
    {"action":"shell","resource":"git branch --delete*","effect":"ask"},
    {"action":"shell","resource":"git worktree remove *","effect":"ask"},
    {"action":"shell","resource":"git worktree prune *","effect":"ask"},
    {"action":"shell","resource":"git push* :*","effect":"ask"},
    {"action":"shell","resource":"git rm *","effect":"ask"},
    {"action":"shell","resource":"git tag -d*","effect":"ask"},
    {"action":"shell","resource":"git commit*--amend*","effect":"ask"},
    {"action":"shell","resource":"git remote set-url*","effect":"ask"},
    {"action":"shell","resource":"git remote remove*","effect":"ask"},
    {"action":"shell","resource":"git remote rename*","effect":"ask"},
    {"action":"shell","resource":"git remote rm*","effect":"ask"},
    {"action":"shell","resource":"git config*remote.*url*","effect":"ask"},
    {"action":"shell","resource":"git config*--remove-section*","effect":"ask"},
    {"action":"shell","resource":"git config*--unset*","effect":"ask"},
    {"action":"shell","resource":"git push*--force*","effect":"ask"},
    {"action":"shell","resource":"git push*-f *","effect":"ask"},
    {"action":"shell","resource":"git push*--delete*","effect":"ask"},
    {"action":"shell","resource":"git push*-d *","effect":"ask"},
    {"action":"shell","resource":"git push*--mirror*","effect":"ask"},
    {"action":"shell","resource":"git push*--prune*","effect":"ask"},
    {"action":"shell","resource":"git reset --hard origin/main*","effect":"ask"},
    {"action":"shell","resource":"git reset --hard */origin/main*","effect":"ask"},
    {"action":"shell","resource":"git reset --hard*","effect":"ask"},
    {"action":"shell","resource":"git reset --merge*","effect":"ask"},
    {"action":"shell","resource":"git reset --keep*","effect":"ask"},
    {"action":"shell","resource":"git checkout -- *","effect":"ask"},
    {"action":"shell","resource":"git checkout .*","effect":"ask"},
    {"action":"shell","resource":"git checkout --ours*","effect":"ask"},
    {"action":"shell","resource":"git checkout --theirs*","effect":"ask"},
    {"action":"shell","resource":"git restore *","effect":"ask"},
    {"action":"shell","resource":"git checkout -f*","effect":"ask"},
    {"action":"shell","resource":"git checkout --force*","effect":"ask"},
    {"action":"shell","resource":"git switch*--discard-changes*","effect":"ask"},
    {"action":"shell","resource":"git switch -f*","effect":"ask"},
    {"action":"shell","resource":"git switch --force*","effect":"ask"},
    {"action":"shell","resource":"git checkout -B*","effect":"ask"},
    {"action":"shell","resource":"git switch -C*","effect":"ask"},
    {"action":"shell","resource":"git branch -f*","effect":"ask"},
    {"action":"shell","resource":"git branch --force*","effect":"ask"},
    {"action":"shell","resource":"git clean*-f*","effect":"ask"},
    {"action":"shell","resource":"git clean*-x*","effect":"ask"},
    {"action":"shell","resource":"git update-ref *","effect":"ask"},
    {"action":"shell","resource":"git symbolic-ref *","effect":"ask"},
    {"action":"shell","resource":"git reflog expire*","effect":"ask"},
    {"action":"shell","resource":"git gc*--prune*","effect":"ask"},
    {"action":"shell","resource":"git prune *","effect":"ask"},
    {"action":"shell","resource":"git filter-branch*","effect":"ask"},
    {"action":"shell","resource":"git filter-repo*","effect":"ask"},
    {"action":"shell","resource":"git submodule deinit*","effect":"ask"},
    {"action":"shell","resource":"git submodule*--force*","effect":"ask"},
    {"action":"shell","resource":"git stash drop*","effect":"ask"},
    {"action":"shell","resource":"git stash clear*","effect":"ask"},
    {"action":"shell","resource":"git stash list *","effect":"allow"},
    {"action":"shell","resource":"git stash show *","effect":"allow"},
    {"action":"shell","resource":"git config --get *","effect":"allow"},
    {"action":"shell","resource":"git config --get-regexp *","effect":"allow"},
    {"action":"shell","resource":"git config --list *","effect":"allow"}
  ]
}
